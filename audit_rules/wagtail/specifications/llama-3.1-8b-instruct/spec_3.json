{
 "operation": {
  "table": "audit_log",
  "id_column": "id",
  "time_column": "ts"
 },
 "principal": {
  "kind": "column",
  "column": "user_id"
 },
 "scopes": [
  {
   "name": "page",
   "ref": "operation.page_id"
  },
  {
   "name": "revision",
   "ref": "operation.revision_id"
  }
 ],
 "paths": [
  {
   "name": "submitter_did_submit_recently",
   "conditions": [
    {
     "kind": "interval",
     "table": "audit_log",
     "source": "audit_log",
     "subject_column": "user_id",
     "subject_ref": "principal",
     "scope_column": "page_id",
     "scope_ref": "scope.page",
     "from_column": "ts",
     "to_column": "ts",
     "id_column": "id"
    }
   ]
  },
  {
   "name": "approval_was_recent",
   "conditions": [
    {
     "kind": "interval",
     "table": "audit_log",
     "source": "audit_log",
     "subject_column": "revision_id",
     "subject_ref": "scope.revision",
     "scope_column": "page_id",
     "scope_ref": "scope.page",
     "from_column": "ts",
     "to_column": "ts",
     "id_column": "id"
    }
   ]
  },
  {
   "name": "submitter_is_not_approver",
   "conditions": [
    {
     "kind": "prior_event",
     "table": "audit_log",
     "source": "audit_log",
     "action_column": "action",
     "action_value": "wagtail.workflow.approve",
     "object_column": "page_id",
     "object_ref": "operation.id",
     "time_column": "ts",
     "id_column": "id",
     "actor_column": "user_id",
     "actor_must_differ": true
    }
   ]
  },
  {
   "name": "approval_was_for_final_task",
   "conditions": [
    {
     "kind": "change_log",
     "table": "audit_log",
     "source": "audit_log",
     "action_column": "action",
     "grant_value": "wagtail.workflow.approve",
     "revoke_value": "wagtail.workflow.reject",
     "scope_column": "page_id",
     "scope_ref": "scope.page",
     "subject_expr": "user_id",
     "subject_ref": "principal",
     "time_column": "ts",
     "id_column": "id"
    }
   ]
  }
 ],
 "coverage": {
  "table": "source_coverage",
  "source_column": "source",
  "from_column": "covered_from",
  "to_column": "covered_to"
 }
}