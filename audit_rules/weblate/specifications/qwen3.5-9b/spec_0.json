{
 "operation": {
  "table": "audit_log",
  "id_column": "id",
  "time_column": "ts"
 },
 "principal": {
  "kind": "binding_event",
  "credential_column": "user_id",
  "table": "account_log",
  "action_column": "activity",
  "action_value": "token-created",
  "credential_expr": "json_extract(params, '$.user_id')",
  "holder_column": "actor_username",
  "time_column": "ts",
  "id_column": "id",
  "source": "account_log"
 },
 "scopes": [
  {
   "name": "username",
   "ref": "principal"
  },
  {
   "name": "team",
   "ref": "operation.team"
  }
 ],
 "paths": [
  {
   "name": "token_validity",
   "conditions": [
    {
     "kind": "interval",
     "table": "token_validity",
     "source": "token_validity",
     "subject_column": "user_id",
     "subject_ref": "principal",
     "from_column": "valid_from",
     "to_column": "valid_to",
     "id_column": "user_id"
    }
   ]
  },
  {
   "name": "creator_in_team",
   "conditions": [
    {
     "kind": "prior_event",
     "table": "account_log",
     "source": "account_log",
     "action_column": "activity",
     "action_value": "team-add",
     "object_column": "team",
     "object_ref": "scope.team",
     "time_column": "ts",
     "id_column": "id",
     "actor_column": "username",
     "actor_must_differ": true
    }
   ]
  }
 ],
 "coverage": {
  "table": "source_coverage",
  "source_column": "source",
  "from_column": "covered_from",
  "to_column": "covered_to"
 }
}