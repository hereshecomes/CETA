{
 "operation": {
  "table": "audit_log",
  "id_column": "id",
  "time_column": "ts"
 },
 "principal": {
  "kind": "binding_table",
  "credential_column": "user_id",
  "table": "tokens",
  "credential_table_column": "user_id",
  "holder_column": "user_id",
  "source": "tokens"
 },
 "scopes": [
  {
   "name": "project",
   "ref": "operation.project_id"
  }
 ],
 "paths": [
  {
   "name": "token_valid",
   "conditions": [
    {
     "kind": "interval",
     "table": "token_validity",
     "source": "token_validity",
     "subject_column": "user_id",
     "subject_ref": "principal",
     "from_column": "valid_from",
     "to_column": "valid_to",
     "id_column": "user_id"
    }
   ]
  },
  {
   "name": "creator_in_team",
   "conditions": [
    {
     "kind": "change_log",
     "table": "account_log",
     "source": "account_log",
     "action_column": "activity",
     "grant_value": "team-add",
     "revoke_value": "team-remove",
     "scope_column": "team",
     "scope_ref": "scope.team",
     "subject_expr": "json_extract(params, '$.username')",
     "subject_ref": "principal",
     "time_column": "ts",
     "id_column": "id"
    }
   ]
  }
 ],
 "coverage": {
  "table": "source_coverage",
  "source_column": "source",
  "from_column": "covered_from",
  "to_column": "covered_to"
 }
}